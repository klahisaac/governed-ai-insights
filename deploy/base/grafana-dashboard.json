    {
      "type": "stat",
      "title": "Writer errors (range)",
      "id": 18,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(insight_narrator_errors_total{namespace=\"insight\"}[$__range])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
